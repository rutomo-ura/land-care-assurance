{\sffamily\fontsize{34}{38}\selectfont\bfseries\color{uraDeep} $title$}\\[3mm]
{\sffamily\LARGE\color{uraBlueDark} $subtitle$}\\[9mm]
{\large\color{uraInk} $author$}\\[4mm]
{\color{uraMuted} $date$}
\vfill
{\color{uraLine}\rule{\textwidth}{0.6pt}}\\[3mm]
{\sffamily\footnotesize\color{uraMuted}%
ura-gis/land-care-assurance \quad\textperiodcentered\quad
/monitoring/ \quad /kpi/ \quad /contractor/}
\end{titlepage}

\setcounter{page}{1}
{\hypersetup{linkcolor=uraDeep}
\titlecontents{section}[0em]{\vspace{3pt}\sffamily\bfseries\color{uraDeep}}
  {\thecontentslabel\quad}{}{\titlerule*[0.6pc]{.}\contentspage}
\titlecontents{subsection}[1.6em]{\sffamily\small\color{uraInk}}
  {\thecontentslabel\quad}{}{\titlerule*[0.6pc]{.}\contentspage}
\tableofcontents}
\newpage

$body$

